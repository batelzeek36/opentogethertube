[Unit]
Description=Movie night file server (~/movie-night/movies on 127.0.0.1:8977)
After=network.target

[Service]
Slice=movie.slice
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/movie-night
Environment=HOME=/home/YOUR_USER
ExecStart=/usr/bin/node serve.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
